# Copy outside the repo to /etc/avtorstudio-backup/backup.env, root:root 600.
PGSERVICE=avtorstudio-backup
PGSERVICEFILE=/etc/avtorstudio-backup/pg_service.conf
PGPASSFILE=/etc/avtorstudio-backup/pgpass
PGCONNECT_TIMEOUT=20
PGAPPNAME=avtorstudio-backup
PGOPTIONS="-c default_transaction_read_only=on"
RCLONE_CONFIG=/etc/avtorstudio-backup/rclone.conf
BACKUP_SOURCE=supabase:
BACKUP_STATE_DIR=/var/lib/avtorstudio-backup
BACKUP_RECOVERY_DIR=/etc/avtorstudio-backup/recovery
RESTIC_REPOSITORY=s3:https://storage.yandexcloud.net/CHANGE_ME/avtorstudio
RESTIC_PASSWORD_FILE=/etc/avtorstudio-backup/restic-password
RESTIC_CACHE_DIR=/var/cache/avtorstudio-backup
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=ru-central1
# Enable ONLY after the isolated restore drill passes.
BACKUP_RETENTION_ENABLED=0
# Optional private URL of an external daily heartbeat monitor, not a public health endpoint.
BACKUP_HEALTHCHECK_URL=
